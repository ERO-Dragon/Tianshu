{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name} - Ferry",
  "icon": "icon.png",
  "description": "Tianshu AI for Fabric. The kernel, the feature modules and the console run on the client; the optional authoritative server component ships with this adapter.",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.rheinmetal.tianshu.fabric.TianshuFabric"
    ],
    "client": [
      "com.rheinmetal.tianshu.fabric.TianshuFabricClient"
    ]
  },
  "mixins": [
    "tianshu.mixins.json",
    "tianshu-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_predicate}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "tianshu_foundry": ">=1.0.0"
  }
}
